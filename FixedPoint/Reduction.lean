import FixedPoint.Syntax

namespace FixedPoint

open Term

mutual
  /-- One reduction step at a finite certification stage. -/
  inductive Step (environment : Environment) : Nat → Context → Term → Term → Prop where
  | any : Step environment stage context (.app .any term) term
  /-- A recursive closure unfolds only when it is applied. -/
  | delta (defined : environment.lookupBody name = some body) :
    Step environment stage context (.app (.const name) argument)
      (.app body argument)
  /-- A recursive declaration certifies its name as a fixed point of its signature. -/
  | recursiveInduction
    (declared : environment.lookupAnnotation name = some annotation) :
    Step environment stage context (.app annotation (.const name)) (.const name)
    | assumption (lookup : Context.Lookup context index annotation) :
    Step environment stage context (.app annotation (.bvar index)) (.bvar index)
    | beta
    (membership : Equiv environment stage context (.app annotation argument) argument) :
    Step environment (stage + 1) context (.app (.lam annotation body) argument)
          (body.instantiate argument)
  | lamAnnotation : Step environment stage context annotation annotation' →
    Step environment stage context (.lam annotation body) (.lam annotation' body)
  | lamBody : Step environment stage (context.extend annotation) body body' →
    Step environment stage context (.lam annotation body) (.lam annotation body')
  | appLeft : Step environment stage context function function' →
    Step environment stage context (.app function argument) (.app function' argument)
  | appRight : Step environment stage context argument argument' →
    Step environment stage context (.app function argument) (.app function argument')
  | lift : Step environment stage context left right →
    Step environment (stage + 1) context left right

  /-- Compatible conversion generated by reduction and restricted `Any` eta. -/
    inductive Equiv (environment : Environment) : Nat → Context → Term → Term → Prop where
    | refl : Equiv environment stage context term term
    | symm : Equiv environment stage context left right →
      Equiv environment stage context right left
    | trans : Equiv environment stage context left middle →
      Equiv environment stage context middle right →
      Equiv environment stage context left right
    | step : Step environment stage context left right →
      Equiv environment stage context left right
    | etaAny :
      Equiv environment stage context
          (.lam .any (.app (term.shift 1) (.bvar 0))) term
    | lamAnnotation : Equiv environment stage context annotation annotation' →
      Equiv environment stage context (.lam annotation body) (.lam annotation' body)
    | lamBody : Equiv environment stage (context.extend annotation) body body' →
      Equiv environment stage context (.lam annotation body) (.lam annotation body')
    | app : Equiv environment stage context function function' →
      Equiv environment stage context argument argument' →
      Equiv environment stage context (.app function argument) (.app function' argument')
    | lift : Equiv environment stage context left right →
      Equiv environment (stage + 1) context left right
end

  def MembershipAt (environment : Environment := .empty) (stage : Nat) (context : Context)
    (term annotation : Term) : Prop :=
    Equiv environment stage context (.app annotation term) term

  def Membership (environment : Environment := .empty)
    (context : Context) (term annotation : Term) : Prop :=
    ∃ stage, MembershipAt environment stage context term annotation

  inductive Steps (environment : Environment) (stage : Nat)
    (context : Context) : Term → Term → Prop where
    | refl : Steps environment stage context term term
    | tail : Step environment stage context term middle →
      Steps environment stage context middle result →
      Steps environment stage context term result

namespace Steps

theorem single (reduction : Step environment stage context left right) :
  Steps environment stage context left right := .tail reduction .refl

theorem trans (left : Steps environment stage context first second)
  (right : Steps environment stage context second third) :
  Steps environment stage context first third := by
  induction left with
  | refl => exact right
  | tail head _ inductionHypothesis => exact .tail head (inductionHypothesis right)

end Steps

def ReducesOne (environment : Environment := .empty)
    (context : Context) (left right : Term) : Prop :=
  ∃ stage, Step environment stage context left right

def Reduces (environment : Environment := .empty)
    (context : Context) (left right : Term) : Prop :=
  ∃ stage, Steps environment stage context left right

def Convertible (environment : Environment := .empty)
    (context : Context) (left right : Term) : Prop :=
  ∃ stage, Equiv environment stage context left right

theorem any_membership (environment : Environment) (context : Context) (term : Term) :
    Membership environment context term .any :=
  ⟨0, .step .any⟩

theorem beta_of_membership
    (membership : Membership environment context argument annotation) :
    ReducesOne environment context (.app (.lam annotation body) argument)
      (body.instantiate argument) := by
  obtain ⟨stage, membership⟩ := membership
  exact ⟨stage + 1, .beta membership⟩

end FixedPoint
